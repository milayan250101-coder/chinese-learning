{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chinese-learning.local/pin/v2.2/schema/pin-manifest.schema.json",
  "title": "PIN Curriculum Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "curriculumId",
    "createdAt",
    "updatedAt",
    "languages",
    "courses",
    "stats"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.2.0"
    },
    "curriculumId": {
      "const": "PIN"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "zh-CN"
          },
          "minContains": 1
        },
        {
          "contains": {
            "const": "en"
          },
          "minContains": 1
        },
        {
          "contains": {
            "const": "de"
          },
          "minContains": 1
        },
        {
          "contains": {
            "const": "fr"
          },
          "minContains": 1
        },
        {
          "contains": {
            "const": "es"
          },
          "minContains": 1
        },
        {
          "contains": {
            "const": "it"
          },
          "minContains": 1
        }
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      }
    },
    "courses": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseId",
          "courseNumber",
          "title",
          "file",
          "contentStatus",
          "acceptanceStatus",
          "firstRoundReviewStatus",
          "crossCourseReviewStatus",
          "atlasReviewStatus",
          "languageReviewStatus"
        ],
        "properties": {
          "courseId": {
            "type": "string",
            "pattern": "^PIN-(0[1-9]|1[0-9])$"
          },
          "courseNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 19
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^pin-(0[1-9]|1[0-9])\\.json$"
          },
          "contentStatus": {
            "enum": [
              "not_imported",
              "draft",
              "in_review",
              "approved"
            ]
          },
          "acceptanceStatus": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          },
          "firstRoundReviewStatus": {
            "enum": [
              "pending",
              "completed"
            ]
          },
          "crossCourseReviewStatus": {
            "enum": [
              "pending",
              "completed"
            ]
          },
          "atlasReviewStatus": {
            "enum": [
              "pending",
              "completed"
            ]
          },
          "languageReviewStatus": {
            "enum": [
              "pending",
              "completed"
            ]
          },
          "firstRoundReviewNotes": {
            "type": "string"
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCourses",
        "importedCourses",
        "firstRoundCompleted",
        "firstRoundPending",
        "crossCourseReviewCompleted",
        "atlasReviewCompleted",
        "languageReviewCompleted",
        "approvedCourses"
      ],
      "properties": {
        "totalCourses": {
          "type": "integer",
          "minimum": 0
        },
        "importedCourses": {
          "type": "integer",
          "minimum": 0
        },
        "firstRoundCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "firstRoundPending": {
          "type": "integer",
          "minimum": 0
        },
        "crossCourseReviewCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "atlasReviewCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "languageReviewCompleted": {
          "type": "integer",
          "minimum": 0
        },
        "approvedCourses": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
