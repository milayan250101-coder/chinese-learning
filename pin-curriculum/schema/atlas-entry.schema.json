{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chinese-learning.local/pin/v2.2/schema/atlas-entry.schema.json",
  "title": "Pinyin Town Atlas Official Vocabulary Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atlasId",
    "hanzi",
    "originalPinyin",
    "source",
    "translations",
    "courseReferences",
    "review"
  ],
  "properties": {
    "atlasId": {
      "type": "string",
      "pattern": "^PTA-P[0-9]{2}-[0-9]{3}$"
    },
    "hanzi": {
      "type": "string",
      "minLength": 1
    },
    "originalPinyin": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "page",
        "scene"
      ],
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "scene": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "translations": {
      "type": "object",
      "required": [
        "zh",
        "en",
        "de",
        "fr",
        "es",
        "it"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      },
      "patternProperties": {
        "^[a-z]{2,3}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "courseReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PIN-CORE-INITIAL-01",
          "PIN-CORE-FINAL-01",
          "PIN-CORE-NASAL-01",
          "PIN-CORE-VOWEL-01"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved",
            "needs_review"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
