{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chinese-learning.local/pin/v2.2/schema/atlas-entry.schema.json",
  "title": "PIN Atlas Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "atlasId",
    "hanzi",
    "pinyin",
    "translations",
    "translationVerified",
    "sourceReference",
    "courseReferences"
  ],
  "properties": {
    "atlasId": {
      "type": "string",
      "pattern": "^ATLAS-[0-9]{5,}$"
    },
    "hanzi": {
      "type": "string",
      "minLength": 1
    },
    "pinyin": {
      "type": "string",
      "minLength": 1
    },
    "translations": {
      "$ref": "translation.schema.json"
    },
    "translationVerified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh-CN",
        "en",
        "de",
        "fr",
        "es",
        "it"
      ],
      "properties": {
        "zh-CN": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "en": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "de": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "fr": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "es": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "it": {
          "enum": [
            "pending",
            "completed"
          ]
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceType"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "enum": [
            "pinyin_town_atlas",
            "teacher_material",
            "other"
          ]
        },
        "slide": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "courseReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PIN-(0[1-9]|1[0-9])$"
      }
    }
  }
}