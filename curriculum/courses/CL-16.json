  "sentence_patterns": [
    {
      "pattern": "这／那＋是＋什么？",
      "explanation": "询问眼前或稍远处物品的名称。",
      "examples": [
        "这是什么？",
        "那是什么？"
      ]
    },
    {
      "pattern": "这／那＋是＋我的／你的＋物品。",
      "explanation": "介绍物品及其所属关系。",
      "examples": [
        "这是我的书。",
        "那是你的包。"
      ]
    },
    {
      "pattern": "主语＋有／没有＋物品。",
      "explanation": "说明自己或别人是否拥有某件物品。",
      "examples": [
        "我有一台电脑。",
        "我没有手表。"
      ]
    },
    {
      "pattern": "物品＋在＋地点／位置。",
      "explanation": "说明物品所在的位置。",
      "examples": [
        "手机在桌子上。",
        "书在包里。"
      ]
    },
    {
      "pattern": "这是谁的＋物品？",
      "explanation": "询问物品属于谁。",
      "examples": [
        "这是谁的笔？",
        "那是谁的手机？"
      ]
    },
    {
      "pattern": "主语＋用＋物品＋动词。",
      "explanation": "简单说明使用某种物品做什么。",
      "examples": [
        "我用电脑工作。",
        "我用笔写字。"
      ]
    }
  ],
