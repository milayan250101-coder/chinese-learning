  "learning_objectives": [
    {
      "objective": "理解并使用“在哪里？”询问活动发生的地点。",
      "success_indicator": "能够针对人物和活动提出至少三个地点问题。"
    },
    {
      "objective": "使用“在＋地点＋动词”说明自己或他人的活动地点。",
      "success_indicator": "能够用完整句子说明至少三个活动及其地点。"
    },
    {
      "objective": "掌握常见地点词汇和生活活动动词的搭配。",
      "success_indicator": "能够根据场景选择合适的地点和活动表达。"
    },
    {
      "objective": "区分“在某地做某事”和“去某地做某事”的基本意思。",
      "success_indicator": "能够根据表达意图正确选择“在”或“去”。"
    }
  ],
