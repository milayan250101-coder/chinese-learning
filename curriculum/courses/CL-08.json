  "sentence_patterns": [
    {
      "pattern": "主语＋在＋地点。",
      "explanation": "说明某人或某物所在的位置。",
      "examples": [
        {
          "simplified": "我在家。",
          "traditional": "我在家。",
          "pinyin": "Wǒ zài jiā.",
          "meaning": "说明我所在的地点是家。"
        },
        {
          "simplified": "老师在学校。",
          "traditional": "老師在學校。",
          "pinyin": "Lǎoshī zài xuéxiào.",
          "meaning": "说明老师所在的地点是学校。"
        }
      ]
    },
    {
      "pattern": "主语＋在＋地点＋动词（＋宾语）。",
      "explanation": "“在＋地点”放在动词前面，说明动作发生的地点。",
      "examples": [
        {
          "simplified": "我在家学习中文。",
          "traditional": "我在家學習中文。",
          "pinyin": "Wǒ zài jiā xuéxí Zhōngwén.",
          "meaning": "我在家里学习中文。"
        },
        {
          "simplified": "他在公司工作。",
          "traditional": "他在公司工作。",
          "pinyin": "Tā zài gōngsī gōngzuò.",
          "meaning": "他在公司工作。"
        }
      ]
    },
    {
      "pattern": "主语＋在哪里＋动词（＋宾语）？",
      "explanation": "使用“在哪里”询问动作发生的地点。",
      "examples": [
        {
          "simplified": "你在哪里吃饭？",
          "traditional": "你在哪裡吃飯？",
          "pinyin": "Nǐ zài nǎlǐ chīfàn?",
          "meaning": "询问对方在哪里吃饭。"
        },
        {
          "simplified": "她在哪里学习中文？",
          "traditional": "她在哪裡學習中文？",
          "pinyin": "Tā zài nǎlǐ xuéxí Zhōngwén?",
          "meaning": "询问她学习中文的地点。"
        }
      ]
    },
    {
      "pattern": "主语＋去＋地点＋动词（＋宾语）。",
      "explanation": "“去”强调前往某个地点或前往该地点的目的，与“在＋地点”说明动作发生地点不同。",
      "examples": [
        {
          "simplified": "我去图书馆看书。",
          "traditional": "我去圖書館看書。",
          "pinyin": "Wǒ qù túshūguǎn kànshū.",
          "meaning": "我前往图书馆看书。"
        },
        {
          "simplified": "我们去饭店吃饭。",
          "traditional": "我們去飯店吃飯。",
          "pinyin": "Wǒmen qù fàndiàn chīfàn.",
          "meaning": "我们前往饭店吃饭。"
        }
      ]
    }
  ],
