  "core_expressions": [
    {
      "expression": "我会说中文。",
      "pinyin": "Wǒ huì shuō Zhōngwén.",
      "meaning_zh": "表示自己已经掌握说中文的技能。",
      "examples": [
        "我会说一点中文。"
      ]
    },
    {
      "expression": "我不会开车。",
      "pinyin": "Wǒ bú huì kāichē.",
      "meaning_zh": "表示自己没有学会开车。",
      "examples": [
        "我不会开车，但是我会骑自行车。"
      ]
    },
    {
      "expression": "我今天能去。",
      "pinyin": "Wǒ jīntiān néng qù.",
      "meaning_zh": "表示今天有条件或有时间前往。",
      "examples": [
        "我今天能去学校。"
      ]
    },
    {
      "expression": "我可以进去吗？",
      "pinyin": "Wǒ kěyǐ jìnqù ma?",
      "meaning_zh": "礼貌地询问是否允许进入。",
      "examples": [
        "老师，我可以进来吗？"
      ]
    },
    {
      "expression": "你应该多休息。",
      "pinyin": "Nǐ yīnggāi duō xiūxi.",
      "meaning_zh": "向对方提出建议。",
      "examples": [
        "你今天很累，应该多休息。"
      ]
    },
    {
      "expression": "我愿意帮你。",
      "pinyin": "Wǒ yuànyì bāng nǐ.",
      "meaning_zh": "表示自己愿意提供帮助。",
      "examples": [
        "如果你需要，我愿意帮你。"
      ]
    },
    {
      "expression": "你能不能帮我？",
      "pinyin": "Nǐ néng bu néng bāng wǒ?",
      "meaning_zh": "询问对方是否有能力或条件帮助自己。",
      "examples": [
        "你能不能帮我拿一下这个？"
      ]
    }
  ],
  "sentence_patterns": [
    {
      "pattern": "主语＋会／不会＋动词（＋宾语）。",
      "explanation": "“会”表示已经掌握的技能或知识；否定形式为“不会”。",
      "examples": [
        {
          "simplified": "我会说中文。",
          "traditional": "我會說中文。",
          "pinyin": "Wǒ huì shuō Zhōngwén.",
          "meaning": "我已经学会说中文。"
        },
        {
          "simplified": "他不会做饭。",
          "traditional": "他不會做飯。",
          "pinyin": "Tā bú huì zuòfàn.",
          "meaning": "他没有学会做饭。"
        }
      ]
    },
    {
      "pattern": "主语＋能／不能＋动词（＋宾语）。",
      "explanation": "“能”表示能力、身体状况或客观条件允许。",
      "examples": [
        {
          "simplified": "我今天能去上课。",
          "traditional": "我今天能去上課。",
          "pinyin": "Wǒ jīntiān néng qù shàngkè.",
          "meaning": "我今天有条件去上课。"
        },
        {
          "simplified": "他生病了，不能工作。",
          "traditional": "他生病了，不能工作。",
          "pinyin": "Tā shēngbìng le, bù néng gōngzuò.",
          "meaning": "因为生病，他现在不能工作。"
        }
      ]
    },
    {
      "pattern": "主语＋可以／不可以＋动词（＋宾语）。",
      "explanation": "“可以”表示允许或条件许可；疑问句常用“可以……吗？”。",
      "examples": [
        {
          "simplified": "这里可以拍照吗？",
          "traditional": "這裡可以拍照嗎？",
          "pinyin": "Zhèlǐ kěyǐ pāizhào ma?",
          "meaning": "询问这里是否允许拍照。"
        },
        {
          "simplified": "这里不可以抽烟。",
          "traditional": "這裡不可以抽煙。",
          "pinyin": "Zhèlǐ bù kěyǐ chōuyān.",
          "meaning": "表示这里不允许抽烟。"
        }
      ]
    },
    {
      "pattern": "主语＋应该／不应该＋动词（＋宾语）。",
      "explanation": "表达建议、责任或认为合适的行为。",
      "examples": [
        {
          "simplified": "你应该早点睡觉。",
          "traditional": "你應該早點睡覺。",
          "pinyin": "Nǐ yīnggāi zǎodiǎn shuìjiào.",
          "meaning": "建议对方早点睡觉。"
        },
        {
          "simplified": "我们不应该迟到。",
          "traditional": "我們不應該遲到。",
          "pinyin": "Wǒmen bù yīnggāi chídào.",
          "meaning": "表示迟到是不合适的行为。"
        }
      ]
    },
    {
      "pattern": "主语＋愿意／不愿意＋动词（＋宾语）。",
      "explanation": "表达个人主观意愿，而不是客观能力或许可。",
      "examples": [
        {
          "simplified": "我愿意帮助你。",
          "traditional": "我願意幫助你。",
          "pinyin": "Wǒ yuànyì bāngzhù nǐ.",
          "meaning": "我主观上愿意帮助你。"
        },
        {
          "simplified": "他不愿意出去。",
          "traditional": "他不願意出去。",
          "pinyin": "Tā bú yuànyì chūqù.",
          "meaning": "他不想出去。"
        }
      ]
    },
    {
      "pattern": "能／会／可以＋动词吗？",
      "explanation": "通过疑问句询问能力、许可或条件，具体含义根据情境判断。",
      "examples": [
        {
          "simplified": "你会说英语吗？",
          "traditional": "你會說英語嗎？",
          "pinyin": "Nǐ huì shuō Yīngyǔ ma?",
          "meaning": "询问对方是否掌握说英语的技能。"
        },
        {
          "simplified": "我可以坐这里吗？",
          "traditional": "我可以坐這裡嗎？",
          "pinyin": "Wǒ kěyǐ zuò zhèlǐ ma?",
          "meaning": "询问是否允许坐在这里。"
        }
      ]
    }
  ],
