  "learning_objectives": [
    {
      "objective": "理解并使用“会”表达已经掌握的技能或知识。",
      "success_indicator": "能够介绍自己会做和不会做的事情。"
    },
    {
      "objective": "使用“能”表达能力、条件或是否有时间。",
      "success_indicator": "能够根据实际情况说明自己能不能做某事。"
    },
    {
      "objective": "使用“可以”询问许可或表达允许。",
      "success_indicator": "能够在日常情景中礼貌地请求许可和回答。"
    },
    {
      "objective": "使用“应该”表达建议或认为合适的做法。",
      "success_indicator": "能够针对简单生活问题提出建议。"
    },
    {
      "objective": "使用“愿意”表达个人意愿。",
      "success_indicator": "能够说明自己愿意或不愿意做某件事情。"
    }
  ],
