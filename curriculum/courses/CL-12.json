  "sentence_patterns": [
    {
      "pattern": "主语＋时间＋上班／下班。",
      "explanation": "用时间说明工作开始或结束的时间。",
      "examples": [
        "我早上九点上班。",
        "我晚上七点下班。"
      ]
    },
    {
      "pattern": "主语＋很／不太＋形容词。",
      "explanation": "描述忙、累等状态。",
      "examples": [
        "我今天很忙。",
        "他今天不太累。"
      ]
    },
    {
      "pattern": "主语＋有空／没空。",
      "explanation": "说明是否有可以自由安排的时间。",
      "examples": [
        "我今天有空。",
        "我明天没空。"
      ]
    },
    {
      "pattern": "主语＋形容词＋不＋形容词？",
      "explanation": "使用正反问句询问状态。",
      "examples": [
        "你今天忙不忙？",
        "你累不累？"
      ]
    },
    {
      "pattern": "主语＋准时／迟到＋动词。",
      "explanation": "描述是否按时进行某项活动。",
      "examples": [
        "我每天准时上班。",
        "他今天上班迟到了。"
      ]
    },
    {
      "pattern": "主语＋很＋形容词，但是＋另一种状态。",
      "explanation": "用但是连接两个不同或相反的情况。",
      "examples": [
        "我今天很忙，但是不累。",
        "他下班很晚，但是今天不忙。"
      ]
    }
  ],
