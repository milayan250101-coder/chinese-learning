  "core_expressions": [
    {
      "expression": "我要……",
      "pinyin": "wǒ yào ...",
      "meaning_zh": "表达自己想做或打算做某事。",
      "examples": [
        "我要喝水。",
        "我要去超市。"
      ]
    },
    {
      "expression": "我不要……",
      "pinyin": "wǒ bú yào ...",
      "meaning_zh": "表达自己不想做某事。",
      "examples": [
        "我不要喝咖啡。",
        "我不要吃这个。"
      ]
    },
    {
      "expression": "我今天要……",
      "pinyin": "wǒ jīntiān yào ...",
      "meaning_zh": "表达今天的计划或安排。",
      "examples": [
        "我今天要工作。",
        "我今天要学习中文。"
      ]
    },
    {
      "expression": "你要不要……？",
      "pinyin": "nǐ yào bú yào ...?",
      "meaning_zh": "询问对方是否愿意做某事，也可以用于邀请。",
      "examples": [
        "你要不要喝茶？",
        "你要不要一起去？"
      ]
    },
    {
      "expression": "好啊！",
      "pinyin": "hǎo a!",
      "meaning_zh": "表示同意或接受邀请。",
      "examples": [
        "好啊，我们一起去！"
      ]
    },
    {
      "expression": "不用了，谢谢。",
      "pinyin": "bú yòng le, xièxie.",
      "meaning_zh": "礼貌地拒绝对方提供的东西或帮助。",
      "examples": [
        "不用了，谢谢。我不喝咖啡。"
      ]
    },
    {
      "expression": "我不想……",
      "pinyin": "wǒ bù xiǎng ...",
      "meaning_zh": "补充表达：说明自己没有做某事的意愿。",
      "examples": [
        "我不想出去。",
        "我不想吃饭。"
      ]
    }
  ],
  "sentence_patterns": [
    {
      "pattern": "主语＋要＋动词（＋宾语）",
      "explanation": "表示主语想做、打算做或需要做某事。具体意思要根据上下文判断。",
      "examples": [
        {
          "simplified": "我要喝水。",
          "traditional": "我要喝水。",
          "pinyin": "Wǒ yào hē shuǐ.",
          "meaning": "我想喝水。"
        },
        {
          "simplified": "她要去超市。",
          "traditional": "她要去超市。",
          "pinyin": "Tā yào qù chāoshì.",
          "meaning": "她打算去超市。"
        }
      ]
    },
    {
      "pattern": "主语＋不要＋动词（＋宾语）",
      "explanation": "可以表示自己不愿意做某事；在对别人说时，也可以表示劝阻或提醒。",
      "examples": [
        {
          "simplified": "我不要喝咖啡。",
          "traditional": "我不要喝咖啡。",
          "pinyin": "Wǒ bú yào hē kāfēi.",
          "meaning": "我不想喝咖啡。"
        },
        {
          "simplified": "不要说话。",
          "traditional": "不要說話。",
          "pinyin": "Bú yào shuōhuà.",
          "meaning": "请不要说话。"
        }
      ]
    },
    {
      "pattern": "主语＋要不要＋动词（＋宾语）？",
      "explanation": "正反问句，用来询问对方是否愿意做某事或提出邀请。",
      "examples": [
        {
          "simplified": "你要不要吃水果？",
          "traditional": "你要不要吃水果？",
          "pinyin": "Nǐ yào bú yào chī shuǐguǒ?",
          "meaning": "你想吃水果吗？"
        },
        {
          "simplified": "你今天要不要去学校？",
          "traditional": "你今天要不要去學校？",
          "pinyin": "Nǐ jīntiān yào bú yào qù xuéxiào?",
          "meaning": "你今天打算去学校吗？"
        }
      ]
    },
    {
      "pattern": "主语＋时间＋要＋动词",
      "explanation": "时间词可以放在主语之后、动词短语之前，说明计划发生的时间。",
      "examples": [
        {
          "simplified": "我晚上要学习中文。",
          "traditional": "我晚上要學習中文。",
          "pinyin": "Wǒ wǎnshang yào xuéxí Zhōngwén.",
          "meaning": "我晚上打算学习中文。"
        }
      ]
    }
  ],
