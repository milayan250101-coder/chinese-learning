    {
      "pattern": "你＋想喝＋什么？",
      "explanation": "询问别人想喝的饮料。",
      "examples": [
        "你想喝什么？",
        "你今天想喝什么？"
      ]
    },
    {
      "pattern": "主语＋要＋数量词＋饮料。",
      "explanation": "表达购买或点选饮料的数量。",
