import os
import requests
import streamlit as st


API_BASE = os.getenv(
    "TEACHER_API_BASE_URL",
    "http://127.0.0.1:8000"
).rstrip("/")

st.set_page_config(
    page_title="教师端 · 学生知识档案",
    page_icon="📚",
    layout="wide",
)

st.title("📚 教师端 · 学生知识档案")
st.caption("管理学生课堂资料，自动分析词汇与语法，持续更新学生知识记录。")


def response_message(response):
    try:
        data = response.json()
        if isinstance(data, dict):
            return data.get("detail") or data.get("message") or str(data)
        return str(data)
    except Exception:
        return response.text[:500] or f"HTTP {response.status_code}"


def api_headers():
    return {
        "Authorization": (
            f"Bearer {st.session_state['teacher_token']}"
        )
    }


# ---------- 教师登录 ----------

if "teacher_token" not in st.session_state:
    st.session_state.teacher_token = None

if not st.session_state.teacher_token:
    st.subheader("教师登录")

    with st.form("teacher_login"):
        username = st.text_input("用户名")
        password = st.text_input("密码", type="password")
        login_clicked = st.form_submit_button("登录")

    if login_clicked:
        try:
            response = requests.post(
                f"{API_BASE}/api/auth/login",
                data={
                    "username": username,
                    "password": password,
                },
                timeout=20,
            )

            if response.ok:
                st.session_state.teacher_token = (
                    response.json()["access_token"]
                )
                st.rerun()
            else:
                st.error(response_message(response))

        except requests.RequestException as exc:
            st.error(f"无法连接后端：{exc}")

    st.stop()


# ---------- 验证当前教师 ----------

try:
    me_response = requests.get(
        f"{API_BASE}/api/auth/me",
        headers=api_headers(),
        timeout=20,
    )

    if me_response.status_code == 401:
        st.session_state.teacher_token = None
        st.warning("登录已过期，请重新登录。")
        st.rerun()

    if not me_response.ok:
        st.error(response_message(me_response))
        st.stop()

    teacher_info = me_response.json()

except requests.RequestException as exc:
    st.error(f"无法连接后端：{exc}")
    st.stop()


top_left, top_right = st.columns([4, 1])

with top_left:
    st.success(
        f"已登录教师：{teacher_info.get('username', '教师')}"
    )

with top_right:
    if st.button("退出登录"):
        st.session_state.teacher_token = None
        st.rerun()


# ---------- 获取当前教师的学生 ----------

try:
    students_response = requests.get(
        f"{API_BASE}/api/students/",
        headers=api_headers(),
        params={"is_active": "true"},
        timeout=20,
    )

    if not students_response.ok:
        st.error(response_message(students_response))
        st.stop()

    students_data = students_response.json()

    if isinstance(students_data, dict):
        students = students_data.get("items", [])
    else:
        students = students_data

except requests.RequestException as exc:
    st.error(f"获取学生列表失败：{exc}")
    st.stop()


if not students:
    st.warning("目前没有可用的学生，请先在学生管理功能中创建学生。")
    st.stop()


student_map = {
    int(student["id"]): student
    for student in students
}

# 上传成功后，下一次上传必须重新选择学生
if st.session_state.pop("reset_student_selection", False):
    st.session_state["student_choice"] = None


def student_label(student_id):
    if student_id is None:
        return "—— 请先选择学生 ——"

    student = student_map[student_id]
    name = student.get("display_name") or "未命名学生"
    code = student.get("student_code") or ""
    return f"{name}（{code}，ID: {student_id}）"


st.divider()
st.subheader("第一步：选择本次笔记所属学生")

student_options = [None] + list(student_map.keys())

selected_student_id = st.selectbox(
    "每次上传都必须重新选择学生",
    options=student_options,
    format_func=student_label,
    key="student_choice",
)

if selected_student_id is not None:
    selected_student = student_map[selected_student_id]
    st.info(
        f"当前选择：{selected_student.get('display_name', '')}"
        f" · 学生 ID：{selected_student_id}"
    )
else:
    st.warning("尚未选择学生，上传功能暂不可用。")


# ---------- 上传并自动分析 ----------

st.divider()
st.subheader("第二步：上传课堂资料")

with st.form("upload_note_form", clear_on_submit=True):
    uploaded_file = st.file_uploader(
        "选择课堂资料",
        type=["txt", "pdf", "docx"],
        help="支持 TXT、PDF、DOCX，单个文件最大 10 MB。",
    )

    note_title = st.text_input(
        "笔记标题（可选）",
        placeholder="例如：第 8 课 · 吃与喝",
    )

    upload_clicked = st.form_submit_button(
        "上传并自动分析",
        disabled=(
            selected_student_id is None
            or uploaded_file is None
        ),
    )


if upload_clicked and uploaded_file is not None:
    student_id = selected_student_id
    student_name = student_map[student_id].get(
        "display_name", "当前学生"
    )

    try:
        upload_response = requests.post(
            f"{API_BASE}/api/student-knowledge/"
            f"students/{student_id}/notes",
            headers=api_headers(),
            data={"title": note_title} if note_title.strip() else {},
            files={
                "file": (
                    uploaded_file.name,
                    uploaded_file.getvalue(),
                    uploaded_file.type or "application/octet-stream",
                )
            },
            timeout=120,
        )

        if not upload_response.ok:
            st.error(
                f"上传失败：{response_message(upload_response)}"
            )
        else:
            note_data = upload_response.json()
            note_id = note_data["id"]

            action_result = {
                "student_name": student_name,
                "student_id": student_id,
                "note_id": note_id,
                "title": note_data.get("title"),
                "upload_status": "success",
                "analysis_status": "not_started",
                "analysis_result": None,
                "analysis_error": None,
            }

            # 上传成功后，立即启动该学生这份笔记的 AI 分析
            try:
                analysis_response = requests.post(
                    f"{API_BASE}/api/student-knowledge/"
                    f"students/{student_id}/notes/{note_id}/analyze",
                    headers=api_headers(),
                    timeout=300,
                )

                if analysis_response.ok:
                    action_result["analysis_result"] = (
                        analysis_response.json()
                    )
                    action_result["analysis_status"] = (
                        action_result["analysis_result"].get(
                            "status", "unknown"
                        )
                    )
                else:
                    action_result["analysis_error"] = (
                        response_message(analysis_response)
                    )
                    action_result["analysis_status"] = "failed"

            except requests.RequestException as exc:
                action_result["analysis_error"] = str(exc)
                action_result["analysis_status"] = "failed"

            st.session_state.last_upload_result = action_result

            # 上传后清空学生选择，下一份资料必须重新选择
            st.session_state.reset_student_selection = True
            st.rerun()

    except requests.RequestException as exc:
        st.error(f"上传请求失败：{exc}")


# ---------- 显示最近一次上传结果 ----------

if "last_upload_result" in st.session_state:
    result = st.session_state.last_upload_result

    st.divider()
    st.subheader("最近一次处理结果")

    st.write(
        f"学生：**{result['student_name']}** "
        f"（ID：{result['student_id']}）"
    )
    st.write(f"笔记：{result['title']}")
    st.write(f"笔记 ID：{result['note_id']}")

    if result["analysis_status"] in ("analyzed", "reused"):
        st.success(
            f"分析状态：{result['analysis_status']}"
        )

        analysis = result.get("analysis_result") or {}

        col1, col2 = st.columns(2)
        col1.metric(
            "识别词汇数量",
            analysis.get("vocabulary_count", 0),
        )
        col2.metric(
            "识别语法数量",
            analysis.get("grammar_count", 0),
        )

        with st.expander("查看本次分析返回数据"):
            st.json(analysis)

    elif result["analysis_status"] == "running":
        st.warning("分析任务正在运行，请稍后重新查看。")

    else:
        st.error(
            "笔记已经保存，但 AI 分析没有成功完成。"
        )
        st.write(result.get("analysis_error") or "请稍后重试。")


# ---------- 查看当前选中学生的课堂资料 ----------

if selected_student_id is not None:
    st.divider()
    st.subheader("该学生的课堂资料")

    try:
        notes_response = requests.get(
            f"{API_BASE}/api/student-knowledge/"
            f"students/{selected_student_id}/notes",
            headers=api_headers(),
            timeout=20,
        )

        if notes_response.ok:
            notes_data = notes_response.json()
            notes = notes_data.get("items", [])

            st.caption(f"资料总数：{notes_data.get('total', 0)}")

            if notes:
                st.dataframe(
                    notes,
                    use_container_width=True,
                    hide_index=True,
                )
            else:
                st.info("该学生目前还没有课堂资料。")
        else:
            st.error(response_message(notes_response))

    except requests.RequestException as exc:
        st.error(f"读取课堂资料失败：{exc}")
